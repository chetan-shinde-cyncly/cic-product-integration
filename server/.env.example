# Copy this to .env and adjust for your environment
# AUTH_SECRET=change_this_to_a_strong_secret
# AUTH_USERNAME=cyncly_admin
# AUTH_PASSWORD=cyncly@2026
# AUTH_TOKEN_EXPIRY=8h
# PORT=5100
# NODE_ENV=development

PORT=5100
# SERVICE_ROLE=api
# DATABASE_URL=postgresql://cyncly_user:cyncly@2026@localhost:5433/cic_catalogs
# Alternatively configure PGHOST, PGPORT, PGDATABASE, PGUSER, and PGPASSWORD.
DATABASE_SSL=false
ADMIN_USERNAME=postgres
ADMIN_PASSWORD=Chetan@1804
DAILY_REFRESH_ENABLED=true
DAILY_REFRESH_HOUR_IST=6
DAILY_REFRESH_MINUTE_IST=00
DAILY_REFRESH_LANG=en-US
DAILY_REFRESH_SPACING_MINUTES=3
PGHOST:postgres
PGPORT:5432
PGDATABASE:cic_catalogs
PGUSER:cyncly_user
PGPASSWORD:cyncly@2026
DATABASE_URL: postgresql://${POSTGRES_USER:-cyncly_user}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB:-cic_catalogs}
